{
    "name": "MnistModel_binary",
    "n_gpu": 1,

    "arch": {
        "type": "MnistModel_temporal",
        "args": {}
    },
    "data_loader": {
        "type": "SmokeMonDataLoader",
        "args":{
            "data_dir": "/ssd2/thermo-smoking/Data/",
            "p_list":"[]",
            "batch_size": 64,
            "shuffle": true,
            "validation_split": 0.2,
            "num_workers": 2
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.00001,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "binary_cross_entropy_with_logits",
    "metrics": [
        "accuracy","recall","precision","f1"
    ],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 50,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 100,

        "save_dir": "saved/",
        "save_period": 1,
        "verbosity": 2,
        
        "monitor": "min val_loss",
        "early_stop": 10,

        "tensorboard": true
    }
}
